{
  "hosting": {
    "site": "sora-kuku",
    "public": "public",
    "ignore": ["**/.*"],
    "headers": [
      {"source": "**/*.mp3", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
      {"source": "**/*.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  }
}
